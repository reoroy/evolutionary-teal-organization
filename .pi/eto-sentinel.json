{
  "enabled": true,
  "rateLimit": {
    "windowMs": 60000,
    "maxPerWindow": 5,
    "action": "block"
  },
  "logFile": "~/.eto/sentinel-log.jsonl",
  "rules": [
    {
      "name": "block-dangerous-commands",
      "type": "bash",
      "pattern": "rm -rf|dd if=|format |mkfs|> /dev/",
      "action": "veto"
    },
    {
      "name": "block-api-key-leak",
      "type": "write",
      "pattern": "(sk-|api_key|apiSecret|DEEPSEEK_API_KEY).{10,}",
      "action": "veto"
    }
  ]
}
