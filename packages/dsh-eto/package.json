{
  "name": "dsh-eto",
  "version": "0.2.1",
  "description": "DeepSeek Harness plugin that mounts ETO (Evolutionary Teal Organization) as 13 tools plus a workbench panel.",
  "license": "MIT",
  "main": "./lib/index.js",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "*"
  },
  "scripts": {
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0-rc.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/reoroy/evolutionary-teal-organization.git",
    "directory": "packages/dsh-eto"
  }
}
